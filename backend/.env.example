# এই ফাইলটি .env নামে copy করো এবং আসল মান দিয়ে পূরণ করো
# .env ফাইল কখনো Git-এ push করবে না

# Django
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon PostgreSQL — neon.tech থেকে পাবে
# Format: postgresql://user:password@hostname/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/learning_mentor?sslmode=require

# Google Gemini — aistudio.google.com থেকে পাবে
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# CORS — React frontend-এর URL
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Submission limit per day
MAX_DAILY_SUBMISSIONS=10
